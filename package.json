{
  "name": "claude-organizer",
  "version": "0.0.1",
  "private": true,
  "description": "Project management system for Claude Code: cards, sprints, roadmaps, docs - exposed via MCP",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "pnpm --filter @claude-organizer/db generate",
    "db:migrate": "pnpm --filter @claude-organizer/db migrate",
    "db:studio": "pnpm --filter @claude-organizer/db studio",
    "dev:api": "pnpm --filter @claude-organizer/api dev",
    "dev:web": "pnpm --filter @claude-organizer/web dev",
    "dev:mcp": "pnpm --filter @claude-organizer/mcp dev",
    "dev": "pnpm db:up && pnpm -r --parallel --filter './packages/*' dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsx": "^4.19.2"
  }
}
