# Postgres (Docker)
POSTGRES_USER=organizer
POSTGRES_PASSWORD=organizer
POSTGRES_DB=organizer
POSTGRES_PORT=5544

# DATABASE_URL used by db, api and mcp packages
DATABASE_URL=postgres://organizer:organizer@localhost:5544/organizer

# API
API_PORT=4400
API_HOST=127.0.0.1

# Web (Nuxt)
NUXT_PUBLIC_API_URL=http://127.0.0.1:4400

# MCP transport
# Default is stdio (local Claude Code). Set MCP_HTTP_PORT to serve over
# Streamable HTTP instead (long-lived service, e.g. Docker/VPS) at /mcp.
# MCP_HTTP_PORT=4402
# Optional bearer token; when set, clients must send Authorization: Bearer <token>.
# MCP_AUTH_TOKEN=
